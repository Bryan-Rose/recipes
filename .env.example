# Copy to .env for docker compose. Every RECIPES_* variable is passed to the backend;
# see backend/.env.example for the full list.

# Where the frontend listens on the host. Loopback by default, so only a reverse
# proxy on the same host (e.g. Caddy) can reach it; 0.0.0.0 exposes it directly.
RECIPES_PORT=8080
# RECIPES_BIND=127.0.0.1

# Owner of ./data on the host (run `id -u` / `id -g`); the backend runs as this user.
# RECIPES_UID=1000
# RECIPES_GID=1000

# Behind HTTPS (Caddy etc.): required, or browsers send the session cookie over plain HTTP too.
# RECIPES_COOKIE_SECURE=true

# Optional OIDC single sign-on. Register the redirect URI with your IdP.
# RECIPES_OIDC_ISSUER=https://id.example.com
# RECIPES_OIDC_CLIENT_ID=recipes
# RECIPES_OIDC_CLIENT_SECRET=
# RECIPES_OIDC_REDIRECT_URI=https://recipes.example.com/api/auth/oidc/callback
# RECIPES_OIDC_DISPLAY_NAME=Pocket ID
