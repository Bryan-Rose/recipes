# Copy to .env for docker compose. Every RECIPES_* variable is passed to the backend;
# see backend/.env.example for the full list.

RECIPES_PORT=8080

# Owner of ./data on the host (run `id -u` / `id -g`); the backend runs as this user.
# RECIPES_UID=1000
# RECIPES_GID=1000

# Set when served over HTTPS (e.g. behind your own reverse proxy).
# RECIPES_COOKIE_SECURE=true

# Optional OIDC single sign-on. Register the redirect URI with your IdP.
# RECIPES_OIDC_ISSUER=https://id.example.lan
# RECIPES_OIDC_CLIENT_ID=recipes
# RECIPES_OIDC_CLIENT_SECRET=
# RECIPES_OIDC_REDIRECT_URI=http://localhost:8080/api/auth/oidc/callback
# RECIPES_OIDC_DISPLAY_NAME=Pocket ID
