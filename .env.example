# Copy to .env next to the compose file (on the server, the deploy folder; see README, Deploying).
# Every RECIPES_* variable is passed to the backend; see backend/.env.example for the full list.
# RECIPES_ALLOWED_SUBNETS also goes to the frontend container's nginx.

# Where the frontend listens on the host. Loopback by default, so only a reverse
# proxy on the same host (e.g. Caddy) can reach it; 0.0.0.0 exposes it directly.
RECIPES_PORT=8080
# RECIPES_BIND=127.0.0.1

# Owner of ./data on the host (run `id -u` / `id -g`); the backend runs as this user.
# RECIPES_UID=1000
# RECIPES_GID=1000

# Behind HTTPS (Caddy etc.): required, or browsers send the session cookie over plain HTTP too.
# RECIPES_COOKIE_SECURE=true

# Optional recipe import through the Claude API; the Import button appears when set.
# RECIPES_ANTHROPIC_API_KEY=sk-ant-...

# Optional OIDC single sign-on. Register the redirect URI with your IdP.
# RECIPES_OIDC_ISSUER=https://id.example.com
# RECIPES_OIDC_CLIENT_ID=recipes
# RECIPES_OIDC_CLIENT_SECRET=          # omit for a public (PKCE) client such as Pocket ID
# RECIPES_OIDC_REDIRECT_URI=https://recipes.example.com/api/auth/oidc/callback
# RECIPES_OIDC_DISPLAY_NAME=Pocket ID
# RECIPES_SECRET_KEY=                  # set with SSO, or logins in progress fail across a restart
# RECIPES_OIDC_CREATE_USERS=false      # default true: anyone the IdP admits gets an account

# Network allowlist: space-separated IPv4 addresses or CIDRs that nginx serves; everyone else
# gets 403. Unset serves every client. IPv4 only, and IPv6 clients are always refused. A bad
# entry stops the container. Never list Docker's own ranges (172.16.0.0/12 etc.). See README.
# RECIPES_ALLOWED_SUBNETS=192.168.1.0/24

# Login-free mode: false means no logins at all. Every request acts as the "household" admin,
# so anyone RECIPES_ALLOWED_SUBNETS lets in can do everything, imports included. The backend
# refuses to start without a valid RECIPES_ALLOWED_SUBNETS. See README, Without logins.
# RECIPES_AUTH_ENABLED=false
