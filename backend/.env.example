RECIPES_DEBUG=true

# Auth
# RECIPES_COOKIE_SECURE=true            # set when served over HTTPS
# RECIPES_SESSION_DAYS=30
# RECIPES_PASSWORD_LOGIN_ENABLED=true   # set false to allow SSO only

# Optional OIDC single sign-on (Pocket ID, Authentik, Authelia, ...).
# Enabled when ISSUER, CLIENT_ID and REDIRECT_URI are all set.
# RECIPES_OIDC_ISSUER=https://id.example.lan
# RECIPES_OIDC_CLIENT_ID=recipes
# RECIPES_OIDC_CLIENT_SECRET=           # omit for a public (PKCE) client
# RECIPES_OIDC_REDIRECT_URI=http://localhost:5173/api/auth/oidc/callback
# RECIPES_OIDC_DISPLAY_NAME=Pocket ID
# RECIPES_OIDC_CREATE_USERS=true
# RECIPES_SECRET_KEY=                   # set for multi-worker deployments
